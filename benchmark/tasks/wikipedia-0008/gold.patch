diff --git a/app/src/main/java/org/wikipedia/savedpages/SavedPageRevisionChecker.kt b/app/src/main/java/org/wikipedia/savedpages/SavedPageRevisionChecker.kt
new file mode 100644
index 0000000..c31a294
--- /dev/null
+++ b/app/src/main/java/org/wikipedia/savedpages/SavedPageRevisionChecker.kt
@@ -0,0 +1,23 @@
+package org.wikipedia.savedpages
+
+import org.wikipedia.database.AppDatabase
+import org.wikipedia.page.PageTitle
+import org.wikipedia.readinglist.database.ReadingListPage
+import org.wikipedia.readinglist.db.ReadingListPageDao
+
+class SavedPageRevisionChecker(
+    private val readingListPageDao: ReadingListPageDao = AppDatabase.instance.readingListPageDao(),
+    private val enqueueSave: () -> Unit = { SavedPageSyncService.enqueue() }
+) {
+    suspend fun checkForUpdates(title: PageTitle, latestRevision: Long) {
+        val outdatedPages = readingListPageDao.getAllPageOccurrences(title)
+            .filter { it.isOutdated(latestRevision) }
+        if (outdatedPages.isEmpty()) {
+            return
+        }
+        // markPagesForOffline() leaves pages that are already offline untouched, so the status is set directly.
+        outdatedPages.forEach { it.status = ReadingListPage.STATUS_QUEUE_FOR_FORCED_SAVE }
+        readingListPageDao.updateReadingListPages(outdatedPages)
+        enqueueSave()
+    }
+}
