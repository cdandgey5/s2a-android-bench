+++ b/storage/database/src/test/java/de/danoeh/antennapod/storage/database/EpisodeTypeStorageTest.java
@@ -0,0 +1,98 @@
+package de.danoeh.antennapod.storage.database;
+
+import android.content.Context;
+import de.danoeh.antennapod.model.feed.Feed;
+import de.danoeh.antennapod.model.feed.FeedItem;
+import de.danoeh.antennapod.model.feed.FeedItemFilter;
+import de.danoeh.antennapod.model.feed.FeedMedia;
+import de.danoeh.antennapod.model.feed.SortOrder;
+import de.danoeh.antennapod.net.sync.serviceinterface.SynchronizationQueue;
+import de.danoeh.antennapod.net.sync.serviceinterface.SynchronizationQueueStub;
+import de.danoeh.antennapod.storage.preferences.UserPreferences;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+
+@RunWith(RobolectricTestRunner.class)
+public class EpisodeTypeStorageTest {
+    private Context context;
+
+    @Before
+    public void setUp() {
+        context = RuntimeEnvironment.getApplication();
+        UserPreferences.init(context);
+        PodDBAdapter.init(context);
+        PodDBAdapter.deleteDatabase();
+        PodDBAdapter adapter = PodDBAdapter.getInstance();
+        adapter.open();
+        adapter.close();
+        SynchronizationQueue.setInstance(new SynchronizationQueueStub());
+    }
+
+    @Test
+    public void testEpisodeTypeSurvivesSaveAndReload() {
+        Feed feed = createFeed();
+        feed.getItems().add(createItem("item-0", "Item 0", FeedItem.EpisodeType.TRAILER, feed));
+        feed.getItems().add(createItem("item-1", "Item 1", FeedItem.EpisodeType.BONUS, feed));
+        feed.getItems().add(createItem("item-2", "Item 2", FeedItem.EpisodeType.FULL, feed));
+        Feed savedFeed = FeedDatabaseWriter.updateFeed(context, feed, false);
+
+        List<FeedItem> storedItems = loadItems(savedFeed);
+        assertEquals(3, storedItems.size());
+        assertEquals("item-0", storedItems.get(0).getItemIdentifier());
+        assertEquals(FeedItem.EpisodeType.TRAILER, storedItems.get(0).getEpisodeType());
+        assertEquals("item-1", storedItems.get(1).getItemIdentifier());
+        assertEquals(FeedItem.EpisodeType.BONUS, storedItems.get(1).getEpisodeType());
+        assertEquals("item-2", storedItems.get(2).getItemIdentifier());
+        assertEquals(FeedItem.EpisodeType.FULL, storedItems.get(2).getEpisodeType());
+    }
+
+    @Test
+    public void testEpisodeTypeUpdatedOnFeedRefresh() {
+        Feed feed = createFeed();
+        feed.getItems().add(createItem("item-0", "Item 0", FeedItem.EpisodeType.TRAILER, feed));
+        feed = FeedDatabaseWriter.updateFeed(context, feed, false);
+
+        List<FeedItem> storedItems = loadItems(feed);
+        assertEquals(1, storedItems.size());
+        assertEquals(FeedItem.EpisodeType.TRAILER, storedItems.get(0).getEpisodeType());
+
+        Feed refreshedFeed = createFeed();
+        refreshedFeed.setId(feed.getId());
+        refreshedFeed.getItems().add(createItem("item-0", "Item 0", FeedItem.EpisodeType.BONUS, refreshedFeed));
+        FeedDatabaseWriter.updateFeed(context, refreshedFeed, false);
+
+        storedItems = loadItems(feed);
+        assertEquals(1, storedItems.size());
+        assertEquals("item-0", storedItems.get(0).getItemIdentifier());
+        assertEquals(FeedItem.EpisodeType.BONUS, storedItems.get(0).getEpisodeType());
+    }
+
+    private List<FeedItem> loadItems(Feed feed) {
+        return DBReader.getFeedItemList(feed, FeedItemFilter.unfiltered(),
+                SortOrder.EPISODE_TITLE_A_Z, 0, Integer.MAX_VALUE);
+    }
+
+    private Feed createFeed() {
+        Feed feed = new Feed("url", null, null);
+        feed.setItems(new ArrayList<>());
+        return feed;
+    }
+
+    private FeedItem createItem(String identifier, String title, FeedItem.EpisodeType episodeType, Feed feed) {
+        FeedItem item = new FeedItem();
+        item.setItemIdentifier(identifier);
+        item.setTitle(title);
+        item.setEpisodeType(episodeType);
+        item.setMedia(new FeedMedia(item, "url-" + title, 2, "mime"));
+        item.setFeed(feed);
+        return item;
+    }
+}
