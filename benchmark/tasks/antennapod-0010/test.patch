+package de.danoeh.antennapod.model.feed;
+
+import org.junit.Test;
+
+import static de.danoeh.antennapod.model.feed.FeedItemMother.anyFeedItemWithImage;
+import static org.junit.Assert.assertEquals;
+
+public class FeedItemEpisodeTypeTest {
+
+    @Test
+    public void testDefaultIsFull() {
+        assertEquals(FeedItem.EpisodeType.FULL, new FeedItem().getEpisodeType());
+    }
+
+    @Test
+    public void testSetEpisodeType() {
+        FeedItem item = new FeedItem();
+        item.setEpisodeType(FeedItem.EpisodeType.BONUS);
+        assertEquals(FeedItem.EpisodeType.BONUS, item.getEpisodeType());
+    }
+
+    @Test
+    public void testUpdateFromOther_episodeTypeChanged() {
+        FeedItem original = anyFeedItemWithImage();
+        FeedItem changedFeedItem = anyFeedItemWithImage();
+        changedFeedItem.setEpisodeType(FeedItem.EpisodeType.TRAILER);
+        original.updateFromOther(changedFeedItem);
+        assertEquals(FeedItem.EpisodeType.TRAILER, original.getEpisodeType());
+
+        FeedItem changedAgain = anyFeedItemWithImage();
+        changedAgain.setEpisodeType(FeedItem.EpisodeType.BONUS);
+        original.updateFromOther(changedAgain);
+        assertEquals(FeedItem.EpisodeType.BONUS, original.getEpisodeType());
+    }
+}
