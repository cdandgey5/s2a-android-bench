# Copy to .env (git-ignored) only if you prefer a file over the user environment variable ABB_OAUTH_TOKEN.
# The harness places this value in each trial's environment block as CLAUDE_CODE_OAUTH_TOKEN and nowhere else.
# Never set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY globally (specs/auth-and-usage.md section 1).
ABB_OAUTH_TOKEN=
# For `abb tasks mine` (GitHub REST API)
GITHUB_TOKEN=
