+package de.danoeh.antennapod.parser.feed.element.namespace;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+import java.io.File;
+
+import de.danoeh.antennapod.model.feed.Feed;
+import de.danoeh.antennapod.model.feed.FeedItem;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+/**
+ * Tests for parsing itunes:episodeType of RSS items.
+ */
+@RunWith(RobolectricTestRunner.class)
+public class ItunesEpisodeTypeTest {
+    private Feed feed;
+
+    @Before
+    public void setUp() throws Exception {
+        File feedFile = FeedParserTestHelper.getFeedFile("feed-rss-testItunesEpisodeType.xml");
+        feed = FeedParserTestHelper.runFeedParser(feedFile);
+        assertEquals(5, feed.getItems().size());
+    }
+
+    @Test
+    public void testTrailer() {
+        assertEquals(FeedItem.EpisodeType.TRAILER, findItem("trailer").getEpisodeType());
+    }
+
+    @Test
+    public void testBonusIgnoresCaseAndWhitespace() {
+        assertEquals(FeedItem.EpisodeType.BONUS, findItem("bonus").getEpisodeType());
+    }
+
+    @Test
+    public void testFull() {
+        assertEquals(FeedItem.EpisodeType.FULL, findItem("full").getEpisodeType());
+    }
+
+    @Test
+    public void testMissingIsFull() {
+        assertEquals(FeedItem.EpisodeType.FULL, findItem("missing").getEpisodeType());
+    }
+
+    @Test
+    public void testUnknownValueIsFull() {
+        assertEquals(FeedItem.EpisodeType.FULL, findItem("unknown").getEpisodeType());
+    }
+
+    private FeedItem findItem(String title) {
+        FeedItem found = null;
+        for (FeedItem item : feed.getItems()) {
+            if (title.equals(item.getTitle())) {
+                found = item;
+            }
+        }
+        assertNotNull(found);
+        return found;
+    }
+}
