diff --git a/app/src/main/java/org/wikipedia/readinglist/ReadingListTitleValidator.kt b/app/src/main/java/org/wikipedia/readinglist/ReadingListTitleValidator.kt
new file mode 100644
index 0000000..1c55e8b
--- /dev/null
+++ b/app/src/main/java/org/wikipedia/readinglist/ReadingListTitleValidator.kt
@@ -0,0 +1,33 @@
+package org.wikipedia.readinglist
+
+import java.text.Normalizer
+
+object ReadingListTitleValidator {
+    const val MAX_LENGTH = 255
+
+    sealed interface Result {
+        data class Valid(val title: String) : Result
+        data object Empty : Result
+        data object Duplicate : Result
+        data object TooLong : Result
+    }
+
+    fun validate(title: String, existingTitles: Collection<String>): Result {
+        val trimmedTitle = title.trim()
+        if (trimmedTitle.isEmpty()) {
+            return Result.Empty
+        }
+        if (trimmedTitle.length > MAX_LENGTH) {
+            return Result.TooLong
+        }
+        val comparableTitle = toComparableTitle(trimmedTitle)
+        if (existingTitles.any { toComparableTitle(it.trim()) == comparableTitle }) {
+            return Result.Duplicate
+        }
+        return Result.Valid(trimmedTitle)
+    }
+
+    private fun toComparableTitle(title: String): String {
+        return Normalizer.normalize(title, Normalizer.Form.NFC).lowercase()
+    }
+}
