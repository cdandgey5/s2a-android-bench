+    public static List<TagItem> groupFeedsByTag(List<Feed> feeds, Map<Long, Integer> feedCounters) {
+        List<TagItem> tagsSorted = makeSortedTagItems(feeds, feedCounters, false);
+        TagItem untaggedTag = makeUntaggedTagItem(feeds);
+        if (!untaggedTag.getFeeds().isEmpty()) {
+            tagsSorted.add(0, untaggedTag);
+        }
+        return tagsSorted;
+    }
+
+    public static List<TagItem> buildTagList(List<Feed> feeds) {
+        List<TagItem> tagsSorted = makeSortedTagItems(feeds, Collections.emptyMap(), true);
+        // Root tag here means "all feeds", this is different from the nav drawer.
+        TagItem rootTag = new TagItem(FeedPreferences.TAG_ROOT);
+        for (Feed feed : feeds) {
+            rootTag.addFeed(feed, 0);
+        }
+        tagsSorted.add(0, rootTag);
+        TagItem untaggedTag = makeUntaggedTagItem(feeds);
+        if (!untaggedTag.getFeeds().isEmpty()) {
+            tagsSorted.add(untaggedTag);
+        }
+        return tagsSorted;
+    }
+
+    private static List<TagItem> makeSortedTagItems(List<Feed> feeds, Map<Long, Integer> feedCounters,
+                                                    boolean skipRootTag) {
+        Map<String, TagItem> tags = new HashMap<>();
+        for (Feed feed : feeds) {
+            for (String tag : feed.getPreferences().getTags()) {
+                if (skipRootTag && FeedPreferences.TAG_ROOT.equals(tag)) {
+                    continue;
+                }
+                if (!tags.containsKey(tag)) {
+                    tags.put(tag, new TagItem(tag));
+                }
+                int counter = feedCounters.containsKey(feed.getId()) ? feedCounters.get(feed.getId()) : 0;
+                tags.get(tag).addFeed(feed, counter);
+            }
+        }
+        List<TagItem> tagsSorted = new ArrayList<>(tags.values());
+        Collections.sort(tagsSorted, (o1, o2) -> o1.getTitle().compareToIgnoreCase(o2.getTitle()));
+        return tagsSorted;
+    }
+
+    private static TagItem makeUntaggedTagItem(List<Feed> feeds) {
+        TagItem untaggedTag = new TagItem(FeedPreferences.TAG_UNTAGGED);
+        for (Feed feed : feeds) {
+            Set<String> tags = feed.getPreferences().getTags();
+            if (tags.isEmpty() || (tags.size() == 1 && tags.contains(FeedPreferences.TAG_ROOT))) {
+                untaggedTag.addFeed(feed, 0);
+            }
+        }
+        return untaggedTag;
+    }
