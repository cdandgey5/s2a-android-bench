diff --git a/app/src/main/java/org/wikipedia/watchlist/WatchlistFilterHelper.kt b/app/src/main/java/org/wikipedia/watchlist/WatchlistFilterHelper.kt
new file mode 100644
index 0000000..4f31729
--- /dev/null
+++ b/app/src/main/java/org/wikipedia/watchlist/WatchlistFilterHelper.kt
@@ -0,0 +1,74 @@
+package org.wikipedia.watchlist
+
+object WatchlistFilterHelper {
+
+    fun filtersCount(includedTypeCodes: Collection<String>, excludedWikiCodes: Collection<String>, appLanguageCodes: List<String>): Int {
+        val findSelectedTypesOfChanges = includedTypeCodes
+            .filter { code -> WatchlistFilterTypes.TYPE_OF_CHANGES_GROUP.map { it.id }.contains(code) }
+
+        // It should include: "not" default values + "non-selected" default values
+        val defaultTypeOfChangeSet = WatchlistFilterTypes.DEFAULT_FILTER_TYPE_OF_CHANGES.map { it.id }.toSet()
+        val nonDefaultChangeTypes = findSelectedTypesOfChanges.subtract(defaultTypeOfChangeSet)
+            .union(defaultTypeOfChangeSet.subtract(findSelectedTypesOfChanges.toSet()))
+
+        // Find the remaining selected filters
+        val findSelectedOthers = includedTypeCodes.subtract(findSelectedTypesOfChanges.toSet())
+        val defaultOthersSet = WatchlistFilterTypes.DEFAULT_FILTER_OTHERS.map { it.id }.toSet()
+        val nonDefaultOthers = defaultOthersSet.subtract(findSelectedOthers)
+
+        return appLanguageCodes.count { excludedWikiCodes.contains(it) } + nonDefaultChangeTypes.size + nonDefaultOthers.size
+    }
+
+    fun latestRevisions(includedTypeCodes: Collection<String>): String? {
+        if (!includedTypeCodes.containsAll(WatchlistFilterTypes.LATEST_REVISIONS_GROUP.map { it.id }) &&
+            !includedTypeCodes.contains(WatchlistFilterTypes.LATEST_REVISION.id)) {
+            return WatchlistFilterTypes.NOT_LATEST_REVISION.value
+        }
+        return null
+    }
+
+    fun showCriteriaString(includedTypeCodes: Collection<String>): String {
+        val list = mutableListOf<String>()
+        if (!includedTypeCodes.containsAll(WatchlistFilterTypes.UNSEEN_CHANGES_GROUP.map { it.id })) {
+            if (includedTypeCodes.contains(WatchlistFilterTypes.UNSEEN_CHANGES.id)) {
+                list.add(WatchlistFilterTypes.UNSEEN_CHANGES.value)
+            }
+            if (includedTypeCodes.contains(WatchlistFilterTypes.SEEN_CHANGES.id)) {
+                list.add(WatchlistFilterTypes.SEEN_CHANGES.value)
+            }
+        }
+
+        if (!includedTypeCodes.containsAll(WatchlistFilterTypes.BOT_EDITS_GROUP.map { it.id })) {
+            if (includedTypeCodes.contains(WatchlistFilterTypes.BOT.id)) {
+                list.add(WatchlistFilterTypes.BOT.value)
+            }
+            if (includedTypeCodes.contains(WatchlistFilterTypes.HUMAN.id)) {
+                list.add(WatchlistFilterTypes.HUMAN.value)
+            }
+        }
+
+        if (!includedTypeCodes.containsAll(WatchlistFilterTypes.MINOR_EDITS_GROUP.map { it.id })) {
+            if (includedTypeCodes.contains(WatchlistFilterTypes.MINOR_EDITS.id)) {
+                list.add(WatchlistFilterTypes.MINOR_EDITS.value)
+            }
+            if (includedTypeCodes.contains(WatchlistFilterTypes.NON_MINOR_EDITS.id)) {
+                list.add(WatchlistFilterTypes.NON_MINOR_EDITS.value)
+            }
+        }
+
+        if (!includedTypeCodes.containsAll(WatchlistFilterTypes.USER_STATUS_GROUP.map { it.id })) {
+            if (includedTypeCodes.contains(WatchlistFilterTypes.REGISTERED.id)) {
+                list.add(WatchlistFilterTypes.REGISTERED.value)
+            }
+            if (includedTypeCodes.contains(WatchlistFilterTypes.UNREGISTERED.id)) {
+                list.add(WatchlistFilterTypes.UNREGISTERED.value)
+            }
+        }
+        return list.joinToString(separator = "|")
+    }
+
+    fun showTypesString(includedTypeCodes: Collection<String>): String {
+        val types = WatchlistFilterTypes.TYPE_OF_CHANGES_GROUP.filter { includedTypeCodes.contains(it.id) }.map { it.value }
+        return types.joinToString(separator = "|")
+    }
+}
