diff --git a/app/src/main/java/org/wikipedia/talk/TalkPageTitleHelper.kt b/app/src/main/java/org/wikipedia/talk/TalkPageTitleHelper.kt
new file mode 100644
index 0000000..fe5a43f
--- /dev/null
+++ b/app/src/main/java/org/wikipedia/talk/TalkPageTitleHelper.kt
@@ -0,0 +1,26 @@
+package org.wikipedia.talk
+
+import org.wikipedia.page.Namespace
+import org.wikipedia.page.PageTitle
+import org.wikipedia.staticdata.TalkAliasData
+import org.wikipedia.staticdata.UserAliasData
+import org.wikipedia.util.StringUtil
+
+object TalkPageTitleHelper {
+
+    fun subjectPageTitle(talkPageTitle: PageTitle): PageTitle {
+        val subjectTitle = talkPageTitle.copy()
+        if (talkPageTitle.namespace() == Namespace.USER_TALK) {
+            subjectTitle.namespace = UserAliasData.valueFor(talkPageTitle.wikiSite.languageCode)
+        } else if (talkPageTitle.namespace() == Namespace.TALK) {
+            subjectTitle.namespace = ""
+        }
+        return subjectTitle
+    }
+
+    fun linkedTitleHtml(pageTitle: PageTitle, stripHtml: Boolean, href: String = "#"): String {
+        val namespace = pageTitle.namespace.ifEmpty { TalkAliasData.valueFor(pageTitle.wikiSite.languageCode) }
+        val displayText = if (stripHtml) StringUtil.removeHTMLTags(pageTitle.displayText) else pageTitle.displayText
+        return "$namespace: <a href='$href'>${StringUtil.removeNamespace(displayText)}</a>"
+    }
+}
